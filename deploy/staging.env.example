# Inject through the host's secret settings. Never commit a populated copy.
NODE_ENV=production
DEMO_MODE=true
PORT=4000
MONGO_DB_NAME=carecycle_demo_staging
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER/?retryWrites=true&w=majority
MONGO_REQUIRE_REPLICA_SET=true
APP_URL=https://YOUR_HOSTNAME
# Use the actual edge proxy IP/CIDRs. No trust-all, guessed networks, or hop counts.
TRUST_PROXY=YOUR_PROXY_IP_OR_CIDR
JWT_SECRET=GENERATE_AN_INDEPENDENT_RANDOM_SECRET
SESSION_SECRET=GENERATE_ANOTHER_INDEPENDENT_RANDOM_SECRET
MAIL_SERVICE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_RECIPIENTS=
