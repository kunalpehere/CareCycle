<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Account moderation | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/admin.css"><script src="/app-nav.js" defer></script><link rel="stylesheet" href="/ui-consistency.css"><link rel="stylesheet" href="/admin-review.css"></head><body><%- include('partials/app-nav', { activePage: 'admin-users' }) %><main class="app-main admin-users"><header class="admin-heading"><div><span class="page-eyebrow">Account moderation</span><h1 class="page-title">Participant accounts.</h1><p class="page-intro">Suspend access when necessary and reactivate accounts after review. Every change is audited.</p></div><a class="admin-button" href="/admin/dashboard">Admin overview</a></header><% if (message) { %><div class="form-message" role="status"><%= message %></div><% } %><form class="surface admin-filters" method="get"><label>Role<select name="role"><option value="">All roles</option><option value="donor" <%= filters.role === 'donor' ? 'selected' : '' %>>Donor</option><option value="ngo" <%= filters.role === 'ngo' ? 'selected' : '' %>>NGO member</option></select></label><label>Status<select name="status"><option value="">All statuses</option><option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option><option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option></select></label><button type="submit">Apply filters</button></form><%- include('partials/admin-pagination', { pagination, base: '/admin/users', filter: 'role=' + encodeURIComponent(filters.role) + '&status=' + encodeURIComponent(filters.status) }) %><section class="account-list"><% users.forEach((user) => { %><article class="surface account-card"><div><span class="account-role"><%= user.role %></span><h2><a href="/admin/users/<%= user._id %>/review"><%= user.name %></a></h2><p><%= user.email %></p><small>Joined <%= new Date(user.createdAt).toLocaleDateString() %></small></div><div class="account-state"><span class="status-badge <%= user.status === 'active' ? 'verified' : 'rejected' %>"><%= user.status %></span><% if (user.status === 'active') { %><form method="post" action="/admin/users/<%= user._id %>/suspended"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= user.moderationVersion || 0 %>"><label>Suspension reason<textarea name="reason" minlength="10" maxlength="500" required rows="2"></textarea></label><button class="reject-button" type="submit">Suspend</button></form><% } else if (user.status === "suspended") { %><form method="post" action="/admin/users/<%= user._id %>/active" data-confirm="Reactivate this account and restore platform access?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= user.moderationVersion || 0 %>"><label>Reactivation reason<textarea name="reason" minlength="10" maxlength="500" required rows="2"></textarea></label><button class="approve-button" type="submit">Reactivate</button></form><% } else { %><p>This account is unavailable for moderation.</p><% } %></div></article><% }) %><% if (!users.length) { %><div class="surface empty-state">No participant accounts match these filters.</div><% } %></section></main></body></html>
