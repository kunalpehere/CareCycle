<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Contact the CareCycle team.">
  <title>Contact | CareCycle</title>
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="/content-pages.css">
  <script src="/transitions.js" defer></script>
  <script src="/app-nav.js" defer></script>
</head>
<body>
  <%- include('partials/app-nav', { activePage: 'contact' }) %>
  <main class="app-main contact-page">
    <header class="contact-heading"><span class="page-eyebrow">Contact CareCycle</span><h1 class="page-title">Let’s keep the conversation moving.</h1><p class="page-intro">Have a question about a listing, equipment condition, or how CareCycle works? Send us a message.</p></header>
    <section class="contact-layout surface">
      <aside class="contact-aside">
        <span class="contact-symbol">C</span>
        <h2>We’re here to help.</h2>
        <p>Share enough detail for us to understand your question. The team will respond through the email address you provide.</p>
        <div class="contact-points"><div><strong>Thoughtful support</strong><span>Questions handled with context</span></div><div><strong>Privacy first</strong><span>Contact details stay within CareCycle</span></div></div>
      </aside>
      <div class="contact-form-wrap">
        <% if (message) { %><div class="form-status" role="status"><%= message %></div><% } %>
        <form action="/contact" method="post" class="contact-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="name">Full name</label><input type="text" id="name" name="name" minlength="2" maxlength="80" autocomplete="name" placeholder="Your full name" required>
          <label for="email">Email address</label><input type="email" id="email" name="email" maxlength="254" autocomplete="email" placeholder="you@example.com" required>
          <label for="message">How can we help?</label><textarea name="message" id="message" minlength="5" maxlength="2000" placeholder="Tell us what you need help with" required></textarea>
          <button type="submit">Send message <span>→</span></button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>
