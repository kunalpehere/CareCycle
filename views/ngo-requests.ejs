<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>My requests | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/requests.css"><script src="/app-nav.js" defer></script></head><body><%- include('partials/app-nav', { activePage: 'requests' }) %><main class="app-main requests-page"><header class="requests-heading"><div><span class="page-eyebrow">Equipment requests</span><h1 class="page-title">Track every request.</h1><p class="page-intro">Requests submitted by <strong><%= organization.name %></strong>. Pending requests can be cancelled before a donor responds.</p></div><a class="browse-button" href="/ngo/equipment">Find equipment</a></header><% if (message) { %><div class="request-message" role="status"><%= message %></div><% } %>
<% if (!requests.length) { %><section class="surface requests-empty"><h2>No requests yet</h2><p>Browse available equipment and submit your organization’s first request.</p><a href="/ngo/equipment">Browse equipment</a></section><% } else { %><section class="request-list"><% requests.forEach((request) => { const donation = request.donation; %><article class="surface request-card"><div class="request-main"><div class="request-title"><span class="request-status status-<%= request.status %>"><%= request.status %></span><h2><%= request.listingSnapshot?.equipment || donation?.equipment || 'Unavailable listing' %></h2></div><p><%= request.beneficiary %></p><div class="request-meta"><span>Requested <strong><%= request.quantity %></strong></span><% if (donation) { %><span>Condition <strong><%= (request.listingSnapshot?.condition || donation.condition) %></strong></span><span>Location <strong><%= (request.listingSnapshot?.location?.city || donation.location.city) %>, <%= (request.listingSnapshot?.location?.state || donation.location.state) %></strong></span><% } %><span>Submitted <strong><%= new Date(request.createdAt).toLocaleDateString() %></strong></span></div><% if (request.responseNote) { %><p class="decision-note"><strong>Resolution note:</strong> <%= request.responseNote %></p><% } %><% if (request.donorContact) { %><div class="contact-exchange"><strong>Your matched donor</strong><p><%= request.donorContact.name %> · <a href="mailto:<%= request.donorContact.email %>"><%= request.donorContact.email %></a></p></div><% } %></div><div class="request-actions"><% if (donation && ['available', 'requested', 'matched', 'pickup_scheduled'].includes(donation.status) && donation.quantity > (donation.allocatedQuantity || 0)) { %><a href="/ngo/equipment/<%= donation._id %>"><%= ['rejected', 'cancelled'].includes(request.status) ? 'Review listing to request again' : 'View listing' %></a><% } %><% if (request.status === 'pending') { %><form method="post" action="/ngo/requests/<%= request._id %>/cancel" data-confirm="Cancel this equipment request?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Cancel request</button></form><% } %></div></article><% }) %></section><% } %></main></body></html>
