<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= title %> | CareCycle Administration</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/admin.css"><link rel="stylesheet" href="/ui-consistency.css"><link rel="stylesheet" href="/admin-review.css"><script src="/app-nav.js" defer></script></head>
<body><%- include('partials/app-nav', { activePage: 'admin-review' }) %><main class="app-main"><a href="<%= back %>">Back to review queue</a><h1 class="page-title"><%= title %></h1>
<p class="page-intro">Administrative review preserves donation quantities and participant handover history. Visibility changes affect discovery and new acceptance. Notes record follow-up and do not resolve participant disagreements.</p>
<section class="surface review-record"><h2>Current record</h2><dl><% fields.forEach(([label,value]) => { %><div><dt><%= label %></dt><dd><%= value ?? 'Not recorded' %></dd></div><% }) %></dl>
<% images.forEach(image => { %><a href="<%= image.url %>">Open private listing image: <%= image.name %></a><% }) %>
<% if (form) { %><form class="review-form" method="post" action="<%= form.action %>" data-confirm="Record this administrative decision with its reason?">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= form.version %>"><% if (form.stamp) { %><input type="hidden" name="_stamp" value="<%= form.stamp %>"><% } %>
<label for="reason">Review reason or follow-up note</label><textarea id="reason" name="reason" minlength="10" maxlength="500" rows="4" required></textarea><button class="admin-button" type="submit"><%= form.label %></button></form><% } %></section>
<% if (commitmentTotal) { %><section class="surface review-record"><h2>Accepted commitments</h2><p><%= commitmentTotal %> accepted commitments. Showing the most recently updated <%= commitments.length %>. Use Exceptions to filter unresolved issues.</p><ul><% commitments.forEach(item => { %><li><a href="/admin/requests/<%= item._id %>/review"><%= item.listing.equipment %>, <%= item.quantity %> committed units</a>. Donor <%= item.donor.status %>; NGO member <%= item.member.status %>.</li><% }) %></ul></section><% } %>
<%- include('partials/admin-history', { history }) %></main></body></html>
