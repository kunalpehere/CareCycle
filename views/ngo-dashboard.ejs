<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>NGO dashboard | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/role-dashboard.css"><link rel="stylesheet" href="/organization.css"><script src="/app-nav.js" defer></script></head><body>
<%- include('partials/app-nav', { activePage: 'ngo-dashboard' }) %><main class="app-main role-dashboard"><header><span class="page-eyebrow">NGO workspace</span><h1 class="page-title">Welcome, <%= user.name %>.</h1><p class="page-intro">Build your verified organization identity before requesting donated medical equipment.</p></header>
<% if (message) { %><div class="form-message" role="status"><%= message %></div><% } %>
<section class="role-summary-grid"><article class="surface role-summary"><span class="summary-icon">01</span><div><strong>Account role</strong><p>NGO member</p></div></article><article class="surface role-summary"><span class="summary-icon">02</span><div><strong>Organization profile</strong><p><%= organization ? 'Submitted' : 'Not submitted' %></p></div></article><article class="surface role-summary"><span class="summary-icon">03</span><div><strong>Verification</strong><p><%= organization ? organization.verificationStatus.charAt(0).toUpperCase() + organization.verificationStatus.slice(1) : 'Not started' %></p></div></article></section>
<% if (!organization) { %><section class="surface next-release-card"><div><span class="page-eyebrow">First step</span><h2>Register your organization</h2><p>Add your organization details and upload official evidence. The file remains private throughout review.</p></div><a class="dashboard-action" href="/ngo/organization">Start verification</a></section>
<% } else { %><section class="surface application-card"><div><span class="status-badge <%= organization.verificationStatus %>"><%= organization.verificationStatus %></span><h2><%= organization.name %></h2><p><%= organization.verificationStatus === 'pending' ? 'Your application is queued for administrator review. You may correct details while it is pending.' : organization.verificationStatus === 'rejected' ? (organization.rejectionReason || 'Corrections are required before you resubmit.') : 'Your organization identity is verified.' %></p><div class="application-meta"><span>Registration: <strong><%= organization.registrationNumber %></strong></span><span>Submitted: <strong><%= new Date(organization.submittedAt).toLocaleDateString() %></strong></span></div></div><div class="application-actions"><a href="/organizations/<%= organization._id %>/verification-document" target="_blank" rel="noopener">View document</a><a class="dashboard-action" href="/ngo/organizations/<%= organization._id %>/edit"><%= organization.verificationStatus === 'verified' ? 'View profile' : organization.verificationStatus === 'rejected' ? 'Correct & resubmit' : 'Edit application' %></a></div></section><% if (organization.verificationStatus === 'verified') { %><section class="surface next-release-card"><div><span class="page-eyebrow">Verified access</span><h2>Discover available medical equipment</h2><p>Search current donation listings by equipment type, condition, and collection area.</p></div><a class="dashboard-action" href="/ngo/equipment">Browse equipment</a></section><% } else { %><section class="surface next-release-card"><div><span class="page-eyebrow">Protected capability</span><h2>Equipment discovery unlocks after verification</h2><p>Only verified organizations can browse donor equipment listings.</p></div><span class="locked-label">Verification required</span></section><% } %><% } %>
</main></body></html>
