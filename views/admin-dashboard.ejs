<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>CareCycle Administration</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/role-dashboard.css"><link rel="stylesheet" href="/organization.css"><link rel="stylesheet" href="/admin.css"><script src="/app-nav.js" defer></script><link rel="stylesheet" href="/ui-consistency.css"><link rel="stylesheet" href="/admin-review.css"></head><body><%- include('partials/app-nav', { activePage: 'admin-dashboard' }) %><main class="app-main role-dashboard"><header class="admin-heading"><div><span class="page-eyebrow">CareCycle Administration</span><h1 class="page-title">Operational oversight.</h1><p class="page-intro">Verify organizations, moderate participant accounts, and follow accountable platform activity.</p></div><a class="admin-button" href="/admin/users">Manage accounts</a></header><% if (message) { %><div class="form-message" role="status"><%= message %></div><% } %><p><a href="/admin/listings">Review listings</a> | <a href="/admin/exceptions">Review commitment exceptions</a></p><p><a href="/admin/receipts">Review donation receipts</a> | <a href="/admin/diagnostics">Operational diagnostics</a></p><section class="admin-metrics"><article class="surface"><strong><%= metrics.userCount %></strong><span>Participant accounts</span></article><article class="surface"><strong><%= metrics.verifiedCount %></strong><span>Verified NGOs</span></article><article class="surface"><strong><%= metrics.donationCount %></strong><span>Donation listings</span></article><article class="surface"><strong><%= metrics.completedRequestCount %></strong><span>Completed matches</span></article></section><div class="admin-columns"><section class="surface queue-card"><div class="queue-heading"><h2>NGO verification queue</h2><span><%= typeof queue === "undefined" ? pendingOrganizations.length : queue.total %> <%= typeof queueStatus === "undefined" ? "pending" : queueStatus %> applications</span></div><% if (typeof queue !== 'undefined') { %><form class="admin-filters" method="get"><label for="status">Application status</label><select id="status" name="status"><% ['pending','verified','rejected'].forEach(value => { %><option value="<%= value %>" <%= queueStatus === value ? 'selected' : '' %>><%= value %></option><% }) %></select><button type="submit">Filter applications</button></form><%- include('partials/admin-pagination', { pagination: queue, base: '/admin/dashboard', filter: 'status=' + queueStatus }) %><% } %><% if (!pendingOrganizations.length) { %><p class="empty-state">There are no applications matching this review filter.</p><% } else { %><div class="queue-list"><% pendingOrganizations.forEach((organization) => { %><a href="/admin/organizations/<%= organization._id %>/review"><div><strong><%= organization.name %></strong><span><%= organization.owner?.name || 'NGO member' %> · <%= organization.contactEmail %></span></div><time><%= new Date(organization.submittedAt).toLocaleDateString() %></time></a><% }) %></div><% } %></section><section class="surface audit-card"><h2>Recent administrative activity</h2><% if (!recentAudit.length) { %><p class="empty-state">No decisions recorded yet.</p><% } else { %><ol><% recentAudit.forEach((entry) => { %><li><strong><%= entry.action.replaceAll('.', ' ') %></strong><span>by <%= entry.actor?.name || 'CareCycle administrator' %> · <%= new Date(entry.createdAt).toLocaleString() %></span></li><% }) %></ol><% } %></section></div><section class="surface access-requests"><div class="queue-heading"><h2>Administration access requests</h2><span><%= accessRequests.length %> pending requests shown (up to 20)</span></div><p>Requests do not create accounts. Verify identity and employment before using the secure provisioning command.</p><% if (accessRequests.length) { %><div class="access-request-grid"><% accessRequests.forEach((request) => { %><article><strong><%= request.name %></strong><span><%= request.workEmail %> · <%= request.department %></span><p><%= request.justification %></p><time><%= new Date(request.createdAt).toLocaleDateString() %></time></article><% }) %></div><% } %></section></main></body></html>
