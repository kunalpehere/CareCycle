<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Donor workspace | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/donor.css"><script src="/app-nav.js" defer></script><link rel="stylesheet" href="/ui-consistency.css"></head><body>
<%- include('partials/app-nav', { activePage: 'donations' }) %>
<main class="app-main donor-page" id="main-content" tabindex="-1">
  <header class="dashboard-heading"><div><span class="page-eyebrow">Donor workspace</span><h1>My donation listings</h1><p>Review requests, prepare collections and track NGO receipt acknowledgement.</p></div><a href="/donate" class="primary-button">Create listing</a></header>
  <% if (message) { %><p class="form-message" role="status"><%= message %></p><% } %>
  <section class="workspace-summary" aria-label="Request totals across your listings">
    <% for (const [key, label] of Object.entries({ decisions: 'Requests to decide', pickups: 'Pickup commitments', waiting: 'Waiting on an NGO', review: 'Requests needing review' })) { %><a class="donor-panel summary-link" href="<%= url({ filter: key, equipment: '', page: '1', taskPage: '1' }) %>"><strong><%= counts[key] %></strong><span><%= label %></span></a><% } %>
  </section>
  <p class="field-note">Counts are requests across all your listings, not donated units or independently verified outcomes. Each request needing a next step appears in one group.</p>
  <form action="/donor/dashboard" method="get" class="workspace-filters donor-panel" aria-label="Filter workspace">
    <div><label for="workspace-filter">Show</label><select id="workspace-filter" name="filter"><% for (const [key, label] of Object.entries(workspaceFilters)) { %><option value="<%= key %>" <%= filter === key ? 'selected' : '' %>><%= label %></option><% } %></select></div>
    <div><label for="workspace-equipment">Equipment</label><select id="workspace-equipment" name="equipment"><option value="">All equipment</option><% for (const type of ['wheelchair', 'walker', 'cane', 'stethoscope']) { %><option value="<%= type %>" <%= equipment === type ? 'selected' : '' %>><%= type %></option><% } %></select></div>
    <button class="primary-button" type="submit">Apply filters</button><a href="/donor/dashboard">Reset filters</a>
  </form>
  <section class="workspace-tasks" aria-labelledby="tasks-title">
    <div class="dashboard-heading"><div><h2 id="tasks-title">Next steps</h2><p><%= matchingTasks %> <%= matchingTasks === 1 ? "request matches" : "requests match" %> these filters. Waiting items explain who needs to act.</p></div><a href="/donor/requests">View all requests</a></div>
    <% if (!tasks.length) { %><div class="donor-panel empty-state"><p>No pending steps match these filters.</p><% if (filter !== 'all' || equipment) { %><a href="/donor/dashboard">Show all listings and steps</a><% } else { %><p>New requests will appear here. Completed and cancelled requests remain in your history.</p><% } %></div><% } else { %>
      <div class="task-list"><% tasks.forEach(task => { %><article class="donor-panel task-card"><div><span class="page-eyebrow"><%= task.group === 'waiting' ? 'NGO action needed' : task.group === 'pickups' ? 'Collection commitment' : 'Donor review' %></span><h3><%= task.label %></h3><p><strong><%= task.equipment %></strong>, requested quantity <%= task.quantity %>. Reference <%= task.requestId.slice(-8) %>.</p><p><%= task.organizationName %></p><p><%= task.detail %></p><% if (task.window) { %><p><strong>Collection window:</strong> <%= task.window %></p><% } %></div><a class="secondary-button" href="<%= task.href %>"><%= task.action %></a></article><% }) %></div>
    <% } %>
    <% if (taskPages > 1) { %><nav class="workspace-pagination" aria-label="Next steps pages"><% if (taskPage > 1) { %><a href="<%= url({ taskPage: String(taskPage - 1) }) %>">Previous steps</a><% } %><span>Steps page <%= taskPage %> of <%= taskPages %></span><% if (taskPage < taskPages) { %><a href="<%= url({ taskPage: String(taskPage + 1) }) %>">Next steps</a><% } %></nav><% } %>
  </section>
  <section aria-labelledby="listings-title"><h2 id="listings-title">Your listings</h2><p class="field-note"><%= matchingListings %> of <%= totalListings %> listings match these filters.</p>
    <% if (!totalListings && !legacyDonations.length) { %><section class="donor-panel empty-state"><h3>No listings yet</h3><p>Create your first medical-equipment donation listing.</p><a href="/donate">Create a listing</a></section><% } else if (!donations.length) { %><section class="donor-panel empty-state"><h3>No listings match</h3><p>Try another status or equipment category.</p><a href="/donor/dashboard">Reset filters</a></section><% } %>
    <div class="donation-grid"><% donations.forEach(donation => { %><article class="donor-panel donation-card">
      <% if (donation.images?.length) { %><img class="card-image" src="/donations/images/<%= donation.images[0].filename %>" alt="<%= donation.equipment %>" loading="lazy"><% } %>
      <div class="card-content"><div class="card-title"><h3><%= donation.equipment %></h3><span class="status status-<%= donation.status %>"><%= donation.status.replaceAll('_', ' ') %></span></div><p><strong>Condition:</strong> <%= donation.condition %></p>
        <% if (donation.moderationStatus === "hidden") { %><p>Hidden from discovery and new acceptance after administrative review. <%= donation.moderationReason %> Existing commitments remain recorded.</p><% } %><% if (donation.accounting) { %><dl class="quantity-breakdown"><div><dt>Total offered</dt><dd><%= donation.accounting.total %></dd></div><div><dt>Available to request</dt><dd><%= donation.requestable %></dd></div><div><dt>Reserved, not handed over</dt><dd><%= donation.accounting.reserved %></dd></div><div><dt>Handed over</dt><dd><%= donation.accounting.handedOver %></dd></div><div><dt>NGO acknowledged</dt><dd><%= donation.acknowledged === null ? 'Needs review' : donation.acknowledged %></dd></div></dl><p class="field-note">Handed-over units remain committed. Acknowledged units are part of the handover total.</p>
        <% } else { %><p>Older quantity records need review. <a href="/contact">Contact support</a> and quote listing <%= donation._id %>.</p><% } %>
        <% if (donation.acknowledged === null && donation.accounting) { %><p class="field-note">Older records do not reconcile with recorded handovers. Contact support before relying on receipt totals.</p><% } %>
        <p><strong>Location:</strong> <%= donation.location?.city || 'Not recorded' %>, <%= donation.location?.state || 'Not recorded' %> <%= donation.location?.postalCode || '' %></p><p><%= donation.description %></p><details class="listing-progress"><summary>Equipment details</summary><%- include("partials/equipment-details", { donation, headingLevel: 4 }) %></details><p class="field-note">Created <time datetime="<%= new Date(donation.createdAt).toISOString() %>"><%= new Date(donation.createdAt).toLocaleDateString('en-GB', { timeZone: 'UTC' }) %></time></p>
        <% if (donation.canChangeQuantity) { %><p><a href="/donations/<%= donation._id %>/quantity">Update total quantity</a></p><% } %>
        <div class="card-actions"><% if (donation.canEdit) { %><a href="/donations/<%= donation._id %>/edit" class="secondary-button">Edit</a><% } %><% if (donation.canWithdraw) { %><form method="post" action="/donations/<%= donation._id %>/withdraw" data-confirm="Withdraw this listing? Pending requests will close and the history will remain."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= donation.__v || 0 %>"><button type="submit" class="danger-button">Withdraw</button></form><% } %></div>
        <% if (donation.progress.length) { %><details class="listing-progress"><summary>Request progress (<%= donation.progress.length %>)</summary><% donation.progress.slice(0, 5).forEach(record => { %><section class="request-progress"><h4>Request <%= record.id.slice(-8) %>, <%= record.quantity %> <%= record.quantity === 1 ? "unit" : "units" %></h4><p><strong><%= record.status %></strong><% if (record.next) { %>. <%= record.next.label %><% } %></p><ol class="progress-timeline"><% record.timeline.forEach(event => { %><li><%= event.label %> <time datetime="<%= event.at %>"><%= new Date(event.at).toLocaleString('en-GB', { timeZone: 'UTC' }) %> UTC</time></li><% }) %></ol><p><a href="<%= record.href %>">Review request <%= record.id.slice(-8) %></a><% if (record.receipt) { %> · <a href="/donor/requests/<%= record.id %>/receipt">Donation receipt</a><% } %></p></section><% }) %><p class="field-note">Up to five recent requests and four recent recorded events per request. <a href="/donor/requests">View all request history</a>.</p></details><% } %>
      </div>
    </article><% }) %></div>
    <% if (pages > 1) { %><nav class="workspace-pagination" aria-label="Listing pages"><% if (page > 1) { %><a href="<%= url({ page: String(page - 1) }) %>">Previous listings</a><% } %><span>Listings page <%= page %> of <%= pages %></span><% if (page < pages) { %><a href="<%= url({ page: String(page + 1) }) %>">Next listings</a><% } %></nav><% } %>
  </section>
  <% if (legacyDonations.length) { %><section class="donor-panel legacy-panel"><h2>Older donation history</h2><p>These records are read-only and are excluded from current quantities and request counts. <a href="/contact">Contact support</a> to review or manage them.</p><ul><% legacyDonations.forEach(item => { %><li><%= item.equipment %>, <%= item.condition %></li><% }) %></ul></section><% } %>
</main></body></html>
