<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Find equipment | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/discovery.css"><script src="/app-nav.js" defer></script></head><body>
<%- include('partials/app-nav', { activePage: 'equipment' }) %><main class="app-main discovery-page"><header class="discovery-heading"><div><span class="page-eyebrow">Verified NGO catalogue</span><h1 class="page-title">Find useful equipment.</h1><p class="page-intro">Browse currently available medical equipment for <strong><%= organization.name %></strong>. Donor contact details appear in your request history after acceptance.</p></div><span class="verified-pill">Organization verified</span></header>
<form class="surface filter-bar" method="get" action="/ngo/equipment"><label>Equipment<select name="equipment"><option value="">All types</option><% equipmentTypes.forEach((type) => { %><option value="<%= type %>" <%= filters.equipment === type ? 'selected' : '' %>><%= type %></option><% }) %></select></label><label>Condition<select name="condition"><option value="">Any condition</option><% conditions.forEach((condition) => { %><option value="<%= condition %>" <%= filters.condition === condition ? 'selected' : '' %>><%= condition %></option><% }) %></select></label><label class="location-filter">Location<input name="location" maxlength="100" value="<%= filters.location %>" placeholder="City, state, or postal code"></label><button type="submit">Apply filters</button><a href="/ngo/equipment">Clear</a></form>
<div class="result-summary"><strong><%= total %></strong> available <%= total === 1 ? 'listing' : 'listings' %></div>
<% if (!donations.length) { %><section class="surface discovery-empty"><h2>No matching equipment</h2><p>Try clearing one or more filters. New donor listings will appear here automatically.</p></section><% } else { %><section class="equipment-grid"><% donations.forEach((donation) => { %><article class="surface equipment-card"><a class="equipment-image" href="/ngo/equipment/<%= donation._id %>"><% if (donation.images?.length) { %><img src="/ngo/equipment/<%= donation._id %>/images/<%= donation.images[0].filename %>" alt="<%= donation.equipment %> available in <%= donation.location.city %>"><% } else { %><span aria-hidden="true">CC</span><% } %><b><%= donation.condition %></b></a><div class="equipment-copy"><span class="equipment-type">Medical equipment</span><h2><a href="/ngo/equipment/<%= donation._id %>"><%= donation.equipment %></a></h2><p><%= donation.description %></p><div class="equipment-facts"><span><strong><%= donation.availableQuantity %></strong> available</span><span><strong><%= donation.location.city %></strong>, <%= donation.location.state %></span></div><a class="detail-link" href="/ngo/equipment/<%= donation._id %>">View listing</a></div></article><% }) %></section><% } %>
<% if (totalPages > 1) { %><nav class="pagination" aria-label="Equipment results pages"><% if (page > 1) { %><a href="/ngo/equipment?<%= filterQuery ? filterQuery + '&' : '' %>page=<%= page - 1 %>">Previous</a><% } %><span>Page <%= page %> of <%= totalPages %></span><% if (page < totalPages) { %><a href="/ngo/equipment?<%= filterQuery ? filterQuery + '&' : '' %>page=<%= page + 1 %>">Next</a><% } %></nav><% } %>
</main></body></html>
