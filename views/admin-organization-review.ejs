<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Review <%= organization.name %> | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/organization.css"><link rel="stylesheet" href="/admin.css"><script src="/app-nav.js" defer></script><link rel="stylesheet" href="/ui-consistency.css"><link rel="stylesheet" href="/admin-review.css"></head><body><%- include('partials/app-nav', { activePage: 'admin-dashboard' }) %><main class="app-main organization-page"><a class="back-link" href="/admin/dashboard">Verification queue</a><span class="page-eyebrow">Organization review</span><h1 class="page-title"><%= organization.name %></h1><p class="page-intro">Submitted by <%= organization.owner?.name %> (<%= organization.owner?.email %>) on <%= new Date(organization.submittedAt).toLocaleDateString() %>.</p><% if (message) { %><div class="form-message" role="alert"><%= message %></div><% } %><p>Owner account: <%= organization.owner?.status || "Unavailable" %>. Only active NGO owners can be approved. Approval reviews the organization, not equipment condition.</p><section class="surface profile-card"><span class="status-badge <%= organization.verificationStatus %>"><%= organization.verificationStatus %></span><dl><div><dt>Registration number</dt><dd><%= organization.registrationNumber %></dd></div><div><dt>Contact</dt><dd><%= organization.contactPerson %> · <%= organization.contactEmail %> · <%= organization.phone %></dd></div><div><dt>Address</dt><dd><%= organization.address.line1 %>, <%= organization.address.city %>, <%= organization.address.state %> <%= organization.address.postalCode %></dd></div><div><dt>Mission</dt><dd><%= organization.description %></dd></div></dl><a class="document-link" href="/organizations/<%= organization.id %>/verification-document" target="_blank" rel="noopener">Open private verification document</a><% if (organization.verificationStatus === 'pending') { %><div class="review-decisions"><form method="post" action="/admin/organizations/<%= organization.id %>/approve" data-confirm="Verify this organization and unlock NGO equipment access?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= organization.__v || 0 %>"><label><input type="checkbox" name="evidenceReviewed" value="yes" required> I reviewed the current application and private evidence</label><label for="approval-reason">Reason for approval</label><textarea id="approval-reason" name="reason" minlength="10" maxlength="1000" rows="3" required></textarea><button class="approve-button" type="submit">Approve organization</button></form><form method="post" action="/admin/organizations/<%= organization.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= organization.__v || 0 %>"><label><input type="checkbox" name="evidenceReviewed" value="yes" required> I reviewed the current application and private evidence</label><label for="reason">Reason for rejection</label><textarea id="reason" name="reason" minlength="10" maxlength="1000" required rows="4" placeholder="Explain what must be corrected before resubmission."></textarea><button class="reject-button" type="submit">Reject application</button></form></div><% } %></section><%- include('partials/admin-history', { history: typeof history === 'undefined' ? [] : history }) %></main></body></html>
