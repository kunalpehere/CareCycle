<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= snapshot.reference %> revision <%= number %> | CareCycle receipt</title>
<meta name="referrer" content="no-referrer"><style>.document{overflow-wrap:anywhere}
*{box-sizing:border-box}body{margin:0;background:#f3f6f2;color:#172b21;font:15px/1.5 Arial,sans-serif}.document{max-width:850px;margin:2rem auto;padding:2.5rem;background:white;border:1px solid #d1dcd5}h1{font-size:28px;margin:.3rem 0}h2{font-size:18px;margin:1.6rem 0 .6rem}.brand{font-size:17px;font-weight:bold;color:#176b4b}.reference{overflow-wrap:anywhere}.summary{display:grid;grid-template-columns:1fr 1fr;gap:.7rem 1.5rem;margin:1.3rem 0}.summary p{margin:0;overflow-wrap:anywhere}.summary strong{display:block}.quantity{padding:1rem;border:1px solid #8baa96;font-size:18px;font-weight:bold}.note{white-space:pre-wrap;overflow-wrap:anywhere}.transfer{border-bottom:1px solid #d1dcd5;padding:.7rem 0;break-inside:avoid}.transfer p{margin:.25rem 0}table{width:100%;border-collapse:collapse;font-size:13px;table-layout:fixed}th,td{text-align:left;vertical-align:top;padding:.55rem;border:1px solid #bfcfc5;overflow-wrap:anywhere}th{background:#eef3ef}thead{display:table-header-group}tr{break-inside:avoid}footer{margin-top:1.7rem;padding-top:1rem;border-top:1px solid #bfcfc5;font-size:12px;color:#34483c}.print-help{max-width:850px;margin:1rem auto;padding:0 1rem}.date{font-size:13px}.revision{padding:.5rem 0;border-bottom:1px solid #d1dcd5;break-inside:avoid}.revision p{margin:.2rem 0}
@media(max-width:600px){.document{margin:0;padding:1.2rem;border:0}.summary{grid-template-columns:1fr}table{font-size:12px}th,td{padding:.35rem}}
@page{size:A4;margin:18mm}@media print{body{background:white;color:black;font-size:10pt}.document{max-width:none;margin:0;padding:0;border:0}.print-help{display:none}.brand{color:black}h1{font-size:21pt}h2{font-size:13pt;break-after:avoid}.summary{grid-template-columns:1fr 1fr}.quantity{font-size:13pt}table{font-size:9pt}th{background:white}footer{color:black}.note{orphans:3;widows:3}}
</style></head><body>
<header class="print-help">Use your browser's Print command to print this receipt or save it as a PDF. This downloaded HTML document works offline.</header>
<main class="document">
<% if (typeof demoMode !== 'undefined' && demoMode) { %><p><strong>SYNTHETIC DEMO RECEIPT.</strong> Fictional equipment and handover. This document is not evidence of a real transfer.</p><% } %>
<div class="brand">CareCycle</div><h1>Donation handover receipt</h1>
<p class="reference"><strong>Reference:</strong> <%= snapshot.reference %><br><strong>Revision:</strong> <%= number %></p>
<p class="date">First issued: <%= snapshot.issuedAt.replace('T', ' ').replace('.000Z', ' UTC').replace('Z', ' UTC') %><br>Revision recorded: <%= revisedAt %> (UTC)<br>Commitment completed: <%= snapshot.completedAt %> (UTC)</p>
<div class="summary"><p><strong>Donor</strong><%= snapshot.donorName %></p><p><strong>Receiving organization</strong><%= snapshot.organizationName %></p><p><strong>Equipment</strong><%= snapshot.equipment %></p><p><strong>Listing condition</strong><%= snapshot.listingCondition %>. Participant description, not an inspection certificate.</p></div>
<p class="quantity">Actual quantity acknowledged by the NGO: <%= snapshot.acknowledgedQuantity %></p>
<p>Original accepted quantity: <%= snapshot.originalQuantity %>. Unfulfilled units released by agreement: <%= snapshot.releasedQuantity %>. Released units are excluded from this receipt's acknowledged total.</p>
<h2>Confirmed transfers</h2>
<% snapshot.transfers.forEach(transfer => { %><article class="transfer"><strong>Transfer <%= transfer.sequence %></strong><p>Original donor declaration: <%= transfer.declaredQuantity %> units. Confirmed actual receipt: <%= transfer.acknowledgedQuantity %> units.</p><p class="date">Donor handover recorded: <%= transfer.handedOverAt %> (UTC)<br>NGO receipt acknowledged: <%= transfer.acknowledgedAt %> (UTC)</p></article><% }) %>
<h2>Aggregate use or outcome note</h2><p class="note"><%= snapshot.outcomeNote || 'No outcome note recorded.' %></p><p class="date">Optional organization statement. The NGO is asked to provide aggregate information without identifying beneficiaries.</p>
<h2>Handover and quantity correction history</h2>
<% if (!snapshot.fulfillmentHistory.length) { %><p>No additional quantity events were recorded.</p><% } else { %><table><thead><tr><th scope="col">Action / participant</th><th scope="col">Recorded at (UTC)</th><th scope="col">Quantities</th></tr></thead><tbody><% snapshot.fulfillmentHistory.forEach(event => { %><tr><td><%= event.action %> by the <%= event.actorRole === 'ngo' ? 'NGO' : 'donor' %></td><td><%= event.at %></td><td><% if (event.quantity !== null) { %>Recorded: <%= event.quantity %><% } %><% if (event.receivedQuantity !== null) { %><br>NGO claim: <%= event.receivedQuantity %><% } %><% if (event.releasedQuantity) { %><br>Released: <%= event.releasedQuantity %><% } %></td></tr><% }) %></tbody></table><% } %>
<h2>Receipt revision history</h2><% revisionHistory.forEach(revision => { %><article class="revision"><strong>Revision <%= revision.number %></strong><p class="date"><%= revision.at %> (UTC), recorded by the <%= revision.actorRole === 'ngo' ? 'NGO' : 'donor' %>.</p><p class="note"><%= revision.reason %></p><% if (revision.amendmentEvidence) { const evidence = revision.amendmentEvidence; %><p class="note">Correction proposed by the <%= evidence.proposalActorRole === 'ngo' ? 'NGO' : 'donor' %> on <%= evidence.proposalAt %> (UTC): <%= evidence.proposalReason %></p><p>Names confirmed: <%= evidence.donorName %>, <%= evidence.organizationName %>.</p><% } %></article><% }) %>
<footer>This receipt records participant-confirmed equipment handover. It is not a tax-deduction certificate, valuation, equipment certification, medical-fitness assessment, or independent inspection. No monetary value or beneficiary identity is certified.</footer>
</main></body></html>
