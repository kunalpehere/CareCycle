<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Request could not be completed | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/ui-consistency.css"><script src="/app-nav.js" defer></script></head><body><%- include('partials/app-nav', { activePage: '' }) %><main class="app-main" id="main-content" tabindex="-1"><section class="surface error-card"><h1 class="page-title"><%= status === 404 ? 'Page not found' : status === 429 ? 'Please try again later' : 'Request could not be completed' %></h1><p role="alert"><%= message %></p><p><%= status === 409 ? "Reload the current record and review its state before submitting again." : status >= 500 ? "Wait briefly, then return to your dashboard to check whether the action was saved before retrying." : "Return to the previous page to review your entries. Refresh it before submitting again if your request token expired." %></p><% if (typeof supportReference !== "undefined" && supportReference) { %><p>Support reference: <code><%= supportReference %></code></p><% } %><p><a href="/home">Open CareCycle home</a></p><p><a href="/contact">Contact CareCycle</a></p></section></main></body></html>
