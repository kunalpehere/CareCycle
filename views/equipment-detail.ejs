<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= donation.equipment %> | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/discovery.css"><link rel="stylesheet" href="/requests.css"><script src="/app-nav.js" defer></script><link rel="stylesheet" href="/ui-consistency.css"></head><body><%- include('partials/app-nav', { activePage: 'equipment' }) %><main class="app-main discovery-page"><a class="back-link" href="/ngo/equipment?<%= typeof returnQuery !== 'undefined' ? returnQuery : '' %>">Back to available equipment</a><% if (message) { %><div class="request-message" role="alert"><%= message %></div><% } %><section class="detail-layout"><div class="detail-gallery surface"><% if (donation.images?.length) { %><img class="detail-primary-image" src="/ngo/equipment/<%= donation._id %>/images/<%= donation.images[0].filename %>" alt="<%= donation.equipment %>"><% if (donation.images.length > 1) { %><div class="detail-thumbnails"><% donation.images.slice(1).forEach((image) => { %><img src="/ngo/equipment/<%= donation._id %>/images/<%= image.filename %>" alt="Additional <%= donation.equipment %> view"><% }) %></div><% } %><% } else { %><div class="detail-placeholder">CareCycle</div><% } %></div><article class="surface detail-copy"><span class="page-eyebrow">Available donation</span><h1><%= donation.equipment %></h1><span class="condition-pill"><%= ({ "brand-new":"Unused", good:"Good appearance, some wear", used:"Used, visible wear", old:"Older, substantial wear" })[donation.condition] || donation.condition %></span><p class="detail-description"><%= donation.description %></p><dl><div><dt>Available quantity</dt><dd><%= donation.availableQuantity %></dd></div><div><dt>Collection area</dt><dd><%= donation.location.city %>, <%= donation.location.state %> <%= donation.location.postalCode %></dd></div><div><dt>Listed</dt><dd><%= new Date(donation.createdAt).toLocaleDateString() %></dd></div></dl><%- include("partials/equipment-details", { donation }) %><div class="privacy-callout"><strong>Donor privacy protected</strong><p>Contact details remain private while your request is reviewed.</p></div>
<% if (existingRequest && !['rejected', 'cancelled'].includes(existingRequest.status)) { %><div class="existing-request"><span class="request-status status-<%= existingRequest.status %>"><%= existingRequest.status %></span><strong>Your organization has a current request for this equipment.</strong><p>Quantity requested: <%= existingRequest.quantity %> · <a href="/ngo/requests">View request history</a></p></div><% } else { %><form class="request-form" method="post" action="/ngo/equipment/<%= donation._id %>/requests"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Request this equipment</h2><% if (existingRequest) { %><p>Your previous attempt was <%= existingRequest.status %>. This submission creates a new attempt and preserves its history.</p><% } %><label>Quantity needed<input type="number" name="quantity" min="1" max="<%= donation.availableQuantity %>" value="1" required><span>Up to <%= donation.availableQuantity %> available</span></label><label>Who will benefit?<textarea name="beneficiary" minlength="10" maxlength="500" rows="3" required placeholder="Describe the facility or community, without names or identifiable beneficiary details."></textarea></label><label>Why is this equipment needed?<textarea name="message" minlength="20" maxlength="1000" rows="4" required placeholder="Explain the need and intended use."></textarea></label><button type="submit">Submit request</button></form><% } %></article></section></main></body></html>
