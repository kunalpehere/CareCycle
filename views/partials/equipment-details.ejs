<% const information = donation.details; const definitions = {
wheelchair: [['seatWidthCm','Seat width (cm)'],['folding','Folding frame']], walker: [['heightAdjustable','Height adjustable'],['folding','Folding frame']], cane: [['heightAdjustable','Height adjustable']], stethoscope: [['chestpiece','Chestpiece'],['tubingCondition','Reported tubing condition']]
}; const functionLabels = { not_checked:'Not checked or unknown', working:'Reported working', partly_working:'Reported partly working', not_working:'Reported not working' }; const values = { unknown:'Unknown', yes:'Yes', no:'No', not_checked:'Not checked', intact:'Appears intact', worn:'Worn', damaged:'Damaged' }; %>
<section class="equipment-detail-record"><h3>Donor-reported equipment details</h3><dl class="equipment-detail-list"><% for (const [key,label] of [['brand','Brand'],['model','Model'],['functionalStatus','Reported operation'],['defects','Known defects'],['missingAccessories','Missing accessories']]) { %><div><dt><%= label %></dt><dd><%= key === 'functionalStatus' ? functionLabels[information?.[key]] || 'Not provided' : information?.[key] || 'Not provided' %></dd></div><% } %>
<% for (const [key,label] of Object.hasOwn(definitions, donation.equipment) ? definitions[donation.equipment] : []) { const value = information?.specifications?.[key]; %><div><dt><%= label %></dt><dd><%= value === undefined || value === null || value === '' ? 'Not provided' : Object.hasOwn(values, value) ? values[value] : value %></dd></div><% } %></dl><p class="field-note">These are donor declarations. Organization verification does not certify equipment condition or medical fitness.</p></section>
