<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= formTitle %> | CareCycle</title>
  <link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/organization.css">
  <script src="/transitions.js" defer></script><script src="/app-nav.js" defer></script>
</head>
<body>
  <%- include('partials/app-nav', { activePage: 'ngo-dashboard' }) %>
  <% const value = organization || {}; const address = value.address || {}; %>
  <main class="app-main organization-page">
    <header class="organization-heading"><div><span class="page-eyebrow">NGO verification</span><h1 class="page-title"><%= formTitle %></h1><p class="page-intro">Tell CareCycle who your organization serves. Your verification document is private and can only be viewed by you and CareCycle administrators.</p></div><span class="secure-note">Private document storage</span></header>
    <% if (message) { %><div class="form-message" role="alert"><%= message %></div><% } %>
    <form class="surface organization-form" method="post" action="<%= formAction %>" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <section><div class="form-section-title"><span>01</span><div><h2>Organization identity</h2><p>Use the name and number shown on your registration document.</p></div></div>
        <div class="form-grid"><label class="wide">Organization name<input name="name" required minlength="2" maxlength="150" value="<%= value.name || '' %>"></label><label>Registration number<input name="registrationNumber" required minlength="3" maxlength="100" value="<%= value.registrationNumber || '' %>"></label><label>Website <small>(optional)</small><input type="url" name="website" maxlength="300" placeholder="https://example.org" value="<%= value.website || '' %>"></label><label class="wide">What does your organization do?<textarea name="description" required minlength="20" maxlength="1500" rows="5" placeholder="Describe your mission, communities served, and equipment needs."><%= value.description || '' %></textarea></label></div>
      </section>
      <section><div class="form-section-title"><span>02</span><div><h2>Primary contact</h2><p>This person will receive verification and donation-request updates.</p></div></div>
        <div class="form-grid"><label>Contact person<input name="contactPerson" required minlength="2" maxlength="100" value="<%= value.contactPerson || '' %>"></label><label>Contact email<input type="email" name="contactEmail" required maxlength="254" value="<%= value.contactEmail || '' %>"></label><label>Phone number<input type="tel" name="phone" required minlength="7" maxlength="30" value="<%= value.phone || '' %>"></label></div>
      </section>
      <section><div class="form-section-title"><span>03</span><div><h2>Registered address</h2><p>Enter the address connected to the organization.</p></div></div>
        <div class="form-grid"><label class="wide">Address line<input name="line1" required minlength="5" maxlength="200" value="<%= value.line1 || address.line1 || '' %>"></label><label>City<input name="city" required minlength="2" maxlength="100" value="<%= value.city || address.city || '' %>"></label><label>State<input name="state" required minlength="2" maxlength="100" value="<%= value.state || address.state || '' %>"></label><label>Postal code<input name="postalCode" required minlength="3" maxlength="20" value="<%= value.postalCode || address.postalCode || '' %>"></label></div>
      </section>
      <section><div class="form-section-title"><span>04</span><div><h2>Verification evidence</h2><p>Upload a registration certificate or equivalent official document.</p></div></div>
        <% if (value.verificationDocument?.filename) { %><div class="current-document"><span>Current document: <strong><%= value.verificationDocument.originalName %></strong></span><a href="/organizations/<%= value._id || value.id %>/verification-document" target="_blank" rel="noopener">View securely</a></div><% } %>
        <label class="file-field">Verification document <% if (!requireDocument) { %><small>(leave empty to keep the current file)</small><% } %><input type="file" name="verificationDocument" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" <%= requireDocument ? 'required' : '' %>><span>PDF, JPEG, or PNG · maximum 8 MB</span></label>
      </section>
      <div class="form-actions"><a href="/ngo/dashboard">Cancel</a><button type="submit"><%= submitLabel %></button></div>
    </form>
  </main>
</body></html>
