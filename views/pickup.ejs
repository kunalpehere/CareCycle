<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Arrange pickup | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/requests.css"><script src="/app-nav.js" defer></script><link rel="stylesheet" href="/ui-consistency.css"></head>
<body>
<%- include('partials/app-nav', { activePage: role + '-requests' }) %>
<main class="app-main pickup-page">
    <a href="/<%= role %>/requests">Back to requests</a>
    <h1 class="page-title">Arrange pickup</h1>
    <p class="page-intro">Collection for <%= request.quantity %> units<% if (request.listingSnapshot) { %> of <%= request.listingSnapshot.equipment %><% } %>. Coordination details are private to this matched donor and NGO.</p>
    <% if (message) { %><div class="request-message" role="status"><%= message %></div><% } %>
    <% const plan = request.pickup; const proposal = plan?.proposal; const form = values || proposal || {}; const active = canArrangePickup(request); const disputed = plan?.missedReport?.disputed; const amounts = requestAccounting(request); %>
    <section class="surface fulfillment-summary" aria-labelledby="fulfillment-title"><h2 id="fulfillment-title">Handover and receipt</h2>
        <p>Accepted: <%= request.quantity %>. Handed over: <%= amounts.handed %>. NGO acknowledged: <%= amounts.acknowledged %>. Remaining reservation: <%= request.status === 'cancelled' ? 0 : amounts.remaining %>. Released: <%= request.releasedQuantity || request.cancellation?.releasedQuantity || 0 %>.</p>
        <% if (!amounts.tracked) { %><p>This request has older handover evidence that needs review before you can continue. Use <a href="/contact">Contact</a> and quote request <%= request._id %>. No transfer or receipt confirmation will be inferred from the old totals.</p><% } %>
        <% if (request.status === 'completed') { %><p><strong>This request is complete.</strong> All recorded transfers were acknowledged and any unfulfilled reservation was released by agreement. Actual acknowledged quantity: <%= amounts.acknowledged %>.</p><p><a href="/<%= role %>/requests/<%= request._id %>/receipt">Donation receipt</a></p><% } else if (!amounts.settled) { %><p>NGO receipt confirmation or discrepancy resolution is required before another pickup can be arranged.</p><% } else if (amounts.handed > 0 && amounts.remaining > 0) { %><p>Arrange another pickup for the remaining units, or agree to release the remaining reservation. The donor cannot cancel units already handed over.</p><% } %>
    </section>
    <section class="surface pickup-current" aria-labelledby="current-plan">
        <h2 id="current-plan">Current pickup plan</h2>
        <% if (request.cancellation) { %>
            <p><strong>Request cancelled by the <%= request.cancellation.actorRole === 'ngo' ? 'NGO' : 'donor' %>.</strong> <%= request.cancellation.releasedQuantity %> reserved units were released.</p>
            <p class="pickup-private"><strong>Cancellation reason:</strong> <%= request.cancellation.reason %></p>
            <p>This request is closed. Review the listing from your request history if you want to request equipment again.</p>
        <% } %>
        <% if (!plan) { %><p>No pickup has been arranged. Either participant can propose a window.</p><% } else { %>
            <p><strong>Status: <%= plan.status %></strong><% if (proposal) { %>. Proposed by the <%= proposal.proposerRole === 'ngo' ? 'NGO' : 'donor' %>.<% } %></p>
            <% if (proposal) { %>
            <p><%= formatPickupTime(proposal.start, proposal.timeZone) %> to <%= formatPickupTime(proposal.end, proposal.timeZone) %> (<%= proposal.timeZone %>)</p>
            <p class="pickup-private"><strong>Pickup address:</strong> <%= proposal.address %></p>
            <% if (proposal.instructions) { %><p class="pickup-private"><strong>Coordination instructions:</strong> <%= proposal.instructions %></p><% } %>
            <% if (active && !disputed && plan.status === 'proposed' && proposal.proposerRole !== role && new Date(proposal.start) > new Date()) { %>
                <form method="post" action="<%= base %>/confirm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= plan.version %>"><button class="accept-button pickup-button" type="submit">Confirm pickup</button></form>
            <% } else if (plan.status === 'proposed' && new Date(proposal.start) > new Date()) { %><p>Waiting for the other participant to confirm. They may propose a different window.</p><% } %>
            <% if (active && !disputed && new Date(proposal.start) <= new Date()) { %><p>This window has started or passed. Propose a new future window to arrange another pickup. A schedule does not record equipment handover.</p><% } %>
            <% } %>
            <% if (plan.status === 'missed') { %>
                <p><strong>Missed pickup reported by the <%= plan.missedReport?.actorRole === 'ngo' ? 'NGO' : 'donor' %>.</strong> Units remain reserved.</p>
                <p class="pickup-private"><%= plan.missedReport?.reason %></p>
                <% if (disputed) { %><p><strong>The participants disagree about this collection.</strong> Rescheduling and cancellation are blocked while the disagreement remains. Coordinate using your matched contact details. If you cannot agree, use <a href="/contact">Contact</a> and quote request <%= request._id %>. Do not include beneficiary details. This report does not prove whether equipment was handed over.</p><% } %>
            <% } %>
        <% } %>
    </section>
    <% if (active && !disputed) { %><section class="surface pickup-editor">
        <h2><%= plan ? 'Propose a revised pickup' : 'Propose pickup' %></h2>
        <p>Enter local times in the named time zone. A revised proposal replaces confirmation and needs the other participant to confirm again.</p>
        <form class="request-form" method="post" action="<%= base %>/propose">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= plan?.version || 0 %>">
            <label for="pickup-start">Window start<input id="pickup-start" name="localStart" type="datetime-local" value="<%= form.localStart || '' %>" required></label>
            <label for="pickup-end">Window end<input id="pickup-end" name="localEnd" type="datetime-local" value="<%= form.localEnd || '' %>" required></label>
            <label for="pickup-zone">Time zone<input id="pickup-zone" name="timeZone" value="<%= form.timeZone || 'Asia/Kolkata' %>" maxlength="100" aria-describedby="zone-help" required></label>
            <p id="zone-help">Use an IANA zone such as Asia/Kolkata, Europe/London, America/New_York, or UTC. Times skipped or repeated during a clock change need a different time.</p>
            <div class="pickup-field"><label for="pickup-address">Pickup address</label><textarea id="pickup-address" name="address" minlength="5" maxlength="500" rows="3" required><%= form.address || '' %></textarea></div>
            <div class="pickup-field"><label for="pickup-instructions">Private coordination instructions (optional)</label><textarea id="pickup-instructions" name="instructions" maxlength="1000" rows="3"><%= form.instructions || '' %></textarea></div>
            <button type="submit"><%= plan ? 'Submit revised proposal' : 'Submit pickup proposal' %></button>
        </form>
    </section><% } %>
    <% if (active) { %><section class="surface pickup-issues" aria-labelledby="issues-title">
        <h2 id="issues-title">Collection changes</h2>
        <% const canMiss = plan?.status === 'confirmed' && proposal && new Date(proposal.end) <= new Date(); const canDispute = plan?.status === 'missed' && !disputed && plan.missedReport && String(plan.missedReport.actor) !== currentUser.id; const canResolve = disputed && String(plan.missedReport.disputedBy) === currentUser.id; %>
        <% if (disputed && !canResolve) { %><p>The participant who recorded the disagreement must withdraw it before you can reschedule or cancel. Use your matched contact details or Contact to seek help.</p><% } %>
        <% if (canMiss || canDispute || canResolve) { const issueAction = canMiss ? 'missed' : canDispute ? 'dispute' : 'resolve'; %>
            <form class="request-form" method="post" action="<%= base %>/<%= issueAction %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= plan.version %>">
                <div class="pickup-field"><label for="issue-reason"><%= canMiss ? 'Reason for missed pickup' : canDispute ? 'Reason for disagreement' : 'Reason for withdrawing disagreement' %></label><textarea id="issue-reason" name="reason" minlength="10" maxlength="500" rows="3" required></textarea></div>
                <% if (!canDispute) { %><label class="pickup-check"><input type="checkbox" name="noHandover" value="yes" required> No equipment has been handed over for the current pickup window.</label><% } %>
                <button type="submit"><%= canMiss ? 'Report missed pickup' : canDispute ? 'Dispute missed report' : 'Withdraw disagreement' %></button>
            </form>
        <% } %>
        <% if (!disputed && amounts.handed === 0) { %>
            <p>Cancellation closes this accepted request and releases its reserved units. Use it only before any equipment has been handed over. Recorded handover evidence prevents release.</p>
            <form class="request-form" method="post" action="<%= base %>/cancel" data-confirm="Cancel this accepted request and release its reserved units?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_version" value="<%= plan?.version || 0 %>">
                <div class="pickup-field"><label for="cancellation-reason">Reason for cancellation</label><textarea id="cancellation-reason" name="reason" minlength="10" maxlength="500" rows="3" required></textarea></div>
                <label class="pickup-check"><input type="checkbox" name="noHandover" value="yes" required> No equipment has been handed over for this request.</label>
                <button type="submit">Cancel accepted request</button>
            </form>
        <% } %>
        <% if (plan?.status === 'confirmed' && !canMiss) { %><p>A missed pickup can be reported after the confirmed window ends.</p><% } %>
    </section><% } %>
    <%- include('partials/fulfillment', { request, role, base, amounts, plan, formatPickupTime }) %>
    <section class="surface pickup-history" aria-labelledby="history-title">
        <h2 id="history-title">Pickup activity</h2>
        <% if (!plan) { %><p>No pickup activity yet.</p><% } else { %><ol><% plan.history.forEach(event => { %>
            <li><strong><%= event.action.replaceAll('_', ' ') %> by the <%= event.actorRole === 'ngo' ? 'NGO' : 'donor' %></strong>
                <time datetime="<%= new Date(event.at).toISOString() %>"><%= formatPickupTime(event.at, event.proposal?.timeZone || 'UTC') %> (<%= event.proposal?.timeZone || 'UTC' %>)</time>
                <% if (event.reason) { %><p class="pickup-private"><strong>Reason:</strong> <%= event.reason %></p><% } %>
                <% if (event.releasedQuantity) { %><p>Released <%= event.releasedQuantity %> reserved units.</p><% } %>
                <% if (event.quantity !== undefined && event.quantity !== null) { %><p>Event quantity: <%= event.quantity %><% if (event.receivedQuantity !== undefined && event.receivedQuantity !== null) { %>. NGO reported received: <%= event.receivedQuantity %><% } %>.</p><% } %>
                <% if (event.proposal) { %>
                <p><%= formatPickupTime(event.proposal.start, event.proposal.timeZone) %> to <%= formatPickupTime(event.proposal.end, event.proposal.timeZone) %> (<%= event.proposal.timeZone %>)</p>
                <p class="pickup-private"><%= event.proposal.address %></p>
                <% if (event.proposal.instructions) { %><p class="pickup-private"><%= event.proposal.instructions %></p><% } %>
                <% } %>
            </li>
        <% }) %></ol><% } %>
    </section>
</main>
</body></html>
