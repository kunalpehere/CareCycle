<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Donation receipts | CareCycle Administration</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/requests.css"><script src="/app-nav.js" defer></script></head><body><%- include('partials/app-nav', { activePage: 'admin-dashboard' }) %>
<main class="app-main requests-page receipt-admin"><a href="/admin/dashboard">Back to administration</a><h1 class="page-title">Donation receipts</h1><p><%= count %> issued receipt records. Administration may review revisions but cannot issue or amend participant receipts.</p><section class="request-list"><% requests.forEach(request => { const revision = request.receipt.revisions.at(-1); %><article class="surface request-card"><div class="request-main"><h2><a href="/admin/requests/<%= request._id %>/receipt"><%= request.receipt.reference %></a></h2><p>Revision <%= revision.number %>: <%= revision.snapshot.donorName %> to <%= revision.snapshot.organizationName %>. Actual acknowledged quantity: <%= revision.snapshot.acknowledgedQuantity %>.</p></div></article><% }) %><% if (!requests.length) { %><p>No receipts on this page.</p><% } %></section><nav aria-label="Receipt pages"><% if (page > 1) { %><a href="/admin/receipts?page=<%= page - 1 %>">Previous page</a><% } %><% if (page * 20 < count) { %><a href="/admin/receipts?page=<%= page + 1 %>">Next page</a><% } %></nav></main></body></html>
