<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Review queue | CareCycle Administration</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/admin.css"><link rel="stylesheet" href="/ui-consistency.css"><link rel="stylesheet" href="/admin-review.css"><script src="/app-nav.js" defer></script></head>
<body><%- include('partials/app-nav', { activePage: 'admin-review' }) %><main class="app-main"><h1 class="page-title"><%= kind === 'listings' ? 'Listing review' : 'Commitment exceptions' %></h1>
<p class="page-intro"><%= kind === 'listings' ? 'Review equipment declarations and control new discovery without changing reservations or handovers.' : 'Accepted commitments with suspended participants, handover discrepancies or missed pickups. Flags come from current records; a review note does not clear them.' %></p>
<form class="surface admin-filters" method="get"><label for="status">Review filter</label><select id="status" name="status">
<% const options = kind === 'listings' ? [['','All listings'],['hidden','Hidden from discovery'],['visible','Not hidden by moderation']] : [['all','All exceptions'],['suspended','Suspended participants'],['discrepancy','Handover discrepancies'],['missed','Missed pickups']]; options.forEach(([value,label]) => { %><option value="<%= value %>" <%= status === value ? 'selected' : '' %>><%= label %></option><% }) %></select><button type="submit">Apply filter</button></form>
<%- include('partials/admin-pagination', { pagination, base: kind === 'listings' ? '/admin/listings' : '/admin/exceptions', filter: 'status=' + encodeURIComponent(status) }) %>
<section class="account-list" aria-label="Review records"><% records.forEach(item => { %><article class="surface review-record">
<% if (kind === 'listings') { %><h2><a href="/admin/listings/<%= item._id %>/review"><%= item.equipment %> listing</a></h2><p><%= item.donor?.name || 'Unavailable donor' %>. Lifecycle: <%= item.status %>. Moderation: <%= item.moderationStatus || 'visible' %>.</p><p><%= item.quantity %> total units; <%= item.allocatedQuantity || 0 %> allocated; <%= item.handedOverQuantity || 0 %> handed over.</p><% if (item.donorSuspended || item.donor?.status === 'suspended') { %><p>Donor suspended. New discovery is restricted.</p><% } %>
<% } else { %><h2><a href="/admin/requests/<%= item._id %>/review"><%= item.listing.equipment %> commitment</a></h2><p><%= item.quantity %> committed units; <%= item.acknowledgedQuantity || 0 %> acknowledged.</p><p>Donor: <%= item.donor.name %>, <%= item.donor.status %>. NGO member: <%= item.member.name %>, <%= item.member.status %>.</p><% if (item.disputed) { %><p>Unresolved handover discrepancy.</p><% } %><% if (item.pickup?.status === 'missed') { %><p>Missed pickup or disagreement recorded.</p><% } %><% } %></article><% }) %>
<% if (!records.length) { %><p class="surface review-record">No records match this filter.</p><% } %></section></main></body></html>
