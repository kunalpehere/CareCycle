<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notifications | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/requests.css"><script src="/app-nav.js" defer></script></head><body><%- include('partials/app-nav', { activePage: 'notifications' }) %>
<main class="app-main pickup-page"><h1 class="page-title">Notifications</h1><p><%= unread %> unread updates. Notifications are private to your account. Lifecycle updates may appear shortly after an action completes.</p>
<% if (message) { %><div class="request-message" role="status"><%= message %></div><% } %>
<section class="surface"><h2>Email preferences</h2><p>Email is optional and contains only a generic sign-in notice. Pickup details, beneficiary information and other participants' contacts stay in the application.</p>
<% if (!emailConfigured) { %><p>Email delivery is disabled in this runtime. Your preference can still be saved.</p><% } %>
<form class="request-form" method="post" action="/notifications/preferences"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="notification-email">Notification email</label><select id="notification-email" name="email"><option value="disabled" <%= !preferences.notificationEmailEnabled ? 'selected' : '' %>>Disabled</option><option value="enabled" <%= preferences.notificationEmailEnabled ? 'selected' : '' %>>Enabled</option></select><button type="submit">Save notification preferences</button></form></section>
<section class="surface notification-inbox"><h2>Your updates</h2><% if (!notifications.length) { %><p>No updates on this page.</p><% } else { %><ol><% notifications.forEach(notification => { %><li class="transfer-record"><h3><%= notificationTitles[notification.kind] || 'CareCycle update' %></h3><p><strong><%= notification.readAt ? 'Read' : 'Unread' %></strong>. <time datetime="<%= new Date(notification.createdAt).toISOString() %>"><%= new Date(notification.createdAt).toISOString() %> (UTC)</time></p><p><a href="/notifications/<%= notification._id %>/open">Review update</a></p>
<% if (!notification.readAt) { %><form class="request-form" method="post" action="/notifications/<%= notification._id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Mark read</button></form><% } %>
<p>Email: <%= notification.mailStatus === 'sent' ? 'accepted by email provider' : notification.mailStatus %><% if (notification.mailStatus === 'pending') { %>. Queued delivery does not affect the donation action.<% } else if (notification.mailStatus === 'failed') { %>. The retry limit was reached. The in-app update remains available.<% } %></p></li><% }) %></ol><% } %>
<nav aria-label="Notification pages"><% if (page > 1) { %><a href="/notifications?page=<%= page - 1 %>">Previous page</a><% } %><% if (page * 20 < count) { %><a href="/notifications?page=<%= page + 1 %>">Next page</a><% } %></nav></section></main></body></html>
