<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Review current availability | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/requests.css"><script src="/app-nav.js" defer></script><link rel="stylesheet" href="/ui-consistency.css"></head><body><%- include('partials/app-nav', { activePage: 'requests' }) %><main class="app-main requests-page"><section class="surface requests-empty"><h1>This action needs a fresh review</h1><p role="alert"><%= message %></p><p>Current requestable quantity: <strong><%= available %></strong></p><% if (listingUrl) { %><p><a href="<%= listingUrl %>">Review current listing</a></p><% } %><p><a href="<%= historyUrl %>">View request history</a></p><p><a href="<%= discoveryUrl %>"><%= currentUser.role === 'donor' ? 'My listings' : 'Find available equipment' %></a></p></section></main></body></html>
