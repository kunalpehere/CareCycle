<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= organization.name %> | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/organization.css"><script src="/transitions.js" defer></script><script src="/app-nav.js" defer></script></head><body>
<%- include('partials/app-nav', { activePage: 'ngo-dashboard' }) %><main class="app-main organization-page"><span class="page-eyebrow">Verified organization</span><h1 class="page-title"><%= organization.name %></h1><p class="page-intro"><%= message %></p><section class="surface profile-card"><div class="status-badge verified">Verified</div><dl><div><dt>Registration</dt><dd><%= organization.registrationNumber %></dd></div><div><dt>Primary contact</dt><dd><%= organization.contactPerson %> · <%= organization.contactEmail %></dd></div><div><dt>Address</dt><dd><%= organization.address.line1 %>, <%= organization.address.city %>, <%= organization.address.state %> <%= organization.address.postalCode %></dd></div><div><dt>Mission</dt><dd><%= organization.description %></dd></div></dl><a class="document-link" href="/organizations/<%= organization.id %>/verification-document" target="_blank" rel="noopener">View verification document</a></section></main></body></html>
