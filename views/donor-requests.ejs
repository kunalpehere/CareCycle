<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Donation requests | CareCycle</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/requests.css"><script src="/app-nav.js" defer></script></head><body><%- include('partials/app-nav', { activePage: 'donor-requests' }) %><main class="app-main requests-page"><header class="requests-heading"><div><span class="page-eyebrow">Donor matching</span><h1 class="page-title">Review equipment requests.</h1><p class="page-intro">Review requests for your equipment. Organization contact information appears only after you accept.</p></div><a class="browse-button" href="/donor/dashboard">My listings</a></header><% if (message) { %><div class="request-message" role="status"><%= message %></div><% } %>
<% if (!requests.length) { %><section class="surface requests-empty"><h2>No requests received</h2><p>Requests from verified organizations will appear here.</p></section><% } else { %><section class="request-list donor-inbox"><% requests.forEach((request) => { const organization = request.organizationPublic; const donation = request.donation; %><article class="surface request-card donor-request-card"><div class="request-main"><div class="request-title"><span class="request-status status-<%= request.status %>"><%= request.status %></span><h2><%= organization?.name || 'Verified organization' %> requests <%= request.listingSnapshot?.equipment || donation?.equipment || 'equipment' %></h2></div><p><strong>Beneficiary:</strong> <%= request.beneficiary %></p><p><strong>Need:</strong> <%= request.message %></p><div class="request-meta"><span>Quantity <strong><%= request.quantity %></strong></span><% if (donation) { %><span>Listing capacity <strong><%= donation.allocatedQuantity || 0 %>/<%= donation.quantity %> matched</strong></span><% } %><span>Requested <strong><%= new Date(request.createdAt).toLocaleDateString() %></strong></span></div><% if (organization?.description) { %><div class="organization-summary"><strong>About <%= organization.name %></strong><p><%= organization.description %></p><span><%= organization.address?.city %>, <%= organization.address?.state %></span></div><% } %><% if (request.organizationContact) { %><div class="contact-exchange"><strong>Matching contact</strong><p><%= request.organizationContact.contactPerson %> · <a href="mailto:<%= request.organizationContact.contactEmail %>"><%= request.organizationContact.contactEmail %></a><% if (request.organizationContact.phone) { %> · <%= request.organizationContact.phone %><% } %></p></div><% } %><% if (request.status === 'accepted') { %><p><a class="pickup-link" href="/donor/requests/<%= request._id %>/pickup">Arrange pickup<% if (request.pickup) { %> (<%= request.pickup.status %>)<% } %></a></p><% } %><% if (request.responseNote) { %><p class="decision-note"><strong>Your response:</strong> <%= request.responseNote %></p><% } %></div>
<% if (request.status === 'pending') { %><div class="decision-panel"><form method="post" action="/donor/requests/<%= request._id %>/accept"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Optional acceptance note<textarea name="responseNote" maxlength="500" rows="2" placeholder="Add pickup or coordination context."></textarea></label><button class="accept-button" type="submit">Accept request</button></form><form method="post" action="/donor/requests/<%= request._id %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Reason for rejection<textarea name="responseNote" minlength="10" maxlength="500" rows="2" required placeholder="Explain why this request cannot be fulfilled."></textarea></label><button class="reject-button" type="submit">Reject request</button></form></div><% } %></article><% }) %></section><% } %></main></body></html>
