{
  "name": "carecycle",
  "version": "0.6.0-alpha.2",
  "description": "Medical equipment donation prototype",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "check": "node scripts/check-source.js",
    "config:check": "node scripts/check-config.js",
    "demo:prepare": "node scripts/prepare-demo.js",
    "deploy:check": "node scripts/check-deployment.js",
    "db:replica:init": "node scripts/initialize-dev-replica.js",
    "db:replica:prepare": "node scripts/prepare-dev-replica.js",
    "migrate:donations": "node scripts/migrate-embedded-donations.js",
    "migrate:quantities": "node scripts/backfill-quantity-contracts.js",
    "migrate:requests": "node scripts/migrate-request-index.js",
    "media:manifest": "node scripts/maintain-private-media.js manifest",
    "media:migrate": "node scripts/maintain-private-media.js migrate",
    "media:cleanup": "node scripts/maintain-private-media.js cleanup",
    "recovery": "node scripts/recovery.js",
    "seed:admin": "node scripts/seed-admin.js",
    "test": "npm run check && node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "test:browser": "node scripts/run-tests.js browser",
    "test:demo-browser": "node scripts/run-demo-browser.js",
    "notifications:process": "node scripts/process-notifications.js --once",
    "test:failure-probe": "node scripts/check-test-failure.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.1.4",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.0",
    "mongodb-connection-string-url": "2.6.0",
    "mongoose": "^6.11.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "axe-core": "4.14.0",
    "mongodb-memory-server-core": "11.3.0",
    "nodemon": "^3.1.14"
  }
}
