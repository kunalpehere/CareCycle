NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=carecycle-dev
MONGO_DB_NAME=CareCycle
# Keep the name in your existing .env if it identifies your current database.
# Transactional matching requires the documented development replica set.
MONGO_REQUIRE_REPLICA_SET=true
# Development needs no proxy. Production requires explicit proxy IPs/CIDRs.
TRUST_PROXY=false
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret

# Email notifications are optional. Leave these blank to store donations without sending mail.
MAIL_SERVICE=gmail
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_RECIPIENTS=
APP_URL=http://localhost:4000
